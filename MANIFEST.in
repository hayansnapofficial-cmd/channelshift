include LICENSE THIRD_PARTY_NOTICES.md CONTRACT.md
recursive-include docs *.md *.json *.txt *LICENSE* *NOTICE* *COPYING*
recursive-include skills *.md *.yaml *.py
recursive-include scripts *.py *.ps1 *.cjs
recursive-include tests *.py *.cjs *.mjs
recursive-include deploy Dockerfile *.yaml *.conf *.md
recursive-include src/channelshift/web *.html *.js *.css
global-exclude *.pyc
global-exclude __pycache__
global-exclude .env .env.* *.key *.pem *.p12 *.pfx *.dpapi
global-exclude *.sqlite *.sqlite-* *.sqlite3 *.sqlite3-* *.db *.db-* *.log
prune .channelshift
prune .codex
prune .venv
prune release
prune dist
